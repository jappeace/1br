cabal-version:      3.0

name:           1br
version:        1.0.0
homepage:       https://github.com/jappeace/1br#readme
bug-reports:    https://github.com/jappeace/1br/issues
author:         Jappie Klooster
maintainer:     hi@jappie.me
copyright:      2026 Jappie Klooster
license:        MIT
license-file:   LICENSE
build-type:     Simple
extra-source-files:
    Readme.md
    LICENSE
extra-doc-files:
    Changelog.md

source-repository head
  type: git
  location: https://github.com/jappeace/1br

common common-options
  default-extensions:
      EmptyCase
      FlexibleContexts
      FlexibleInstances
      InstanceSigs
      MultiParamTypeClasses
      LambdaCase
      MultiWayIf
      NamedFieldPuns
      TupleSections
      DeriveFoldable
      DeriveFunctor
      DeriveGeneric
      DeriveLift
      DeriveTraversable
      DerivingStrategies
      GeneralizedNewtypeDeriving
      StandaloneDeriving
      OverloadedStrings
      TypeApplications
      NumericUnderscores
      ImportQualifiedPost

  ghc-options:
    -O2 -Wall -Werror -Wincomplete-uni-patterns
    -Wincomplete-record-updates -Widentities -Wredundant-constraints
    -Wcpp-undef -fwarn-tabs -Wpartial-fields
    -fdefer-diagnostics -Wunused-packages
    -fenable-th-splice-warnings
    -threaded -rtsopts "-with-rtsopts=-N -M7G -T"

  build-depends:
      base >=4.9.1.0 && <4.22.0 || ^>=4.22.0

  default-language: Haskell2010

library
  import: common-options
  exposed-modules:
      Aggregate
      AggregateEffectful
      AggregateMtl
      Generate
  other-modules:
      Paths_1br
  hs-source-dirs:
      src
  -- Decision: -fomit-yields on the library (overriding the template's
  -- -fno-omit-yields) because the per-line parse loop allocates nothing;
  -- with -fno-omit-yields GHC inserts interruption checks into that loop,
  -- which costs measurable throughput on a billion iterations. The
  -- executables keep the template default since they only wrap the library.
  ghc-options: -fomit-yields
  build-depends:
      bytestring,
      containers,
      effectful-core,
      mtl,
      primitive

executable exe
  import: common-options
  main-is: Main.hs
  hs-source-dirs:
      app
  build-depends:
      1br
  ghc-options: -Wno-unused-packages

executable exe-effectful
  import: common-options
  main-is: MainEffectful.hs
  hs-source-dirs:
      app
  build-depends:
      1br
  ghc-options: -Wno-unused-packages

executable exe-effectful-dynamic
  import: common-options
  main-is: MainEffectfulDynamic.hs
  hs-source-dirs:
      app
  build-depends:
      1br
  ghc-options: -Wno-unused-packages

executable exe-mtl
  import: common-options
  main-is: MainMtl.hs
  hs-source-dirs:
      app
  build-depends:
      1br
  ghc-options: -Wno-unused-packages

executable generate
  import: common-options
  main-is: GenerateMain.hs
  hs-source-dirs:
      gen
  build-depends:
      1br
  ghc-options: -Wno-unused-packages

test-suite unit
  import: common-options
  type: exitcode-stdio-1.0
  main-is: Test.hs
  ghc-options: -Wno-unused-packages
  other-modules:
      Paths_1br
  hs-source-dirs:
      test
  build-depends:
      tasty,
      tasty-hunit,
      bytestring,
      directory,
      primitive,
      process,
      1br
